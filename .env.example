# Copiar a .env. Ambos valores están en Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Los secretos de las funciones NO van en ningún archivo. Se cargan una vez con:
#   supabase secrets set AUTOPEN_BASE_URL=https://firma.ejemplo.com AUTOPEN_API_KEY=<clave>
# AUTOPEN_BASE_URL: la URL del servicio de firma, sin barra final.
# AUTOPEN_API_KEY:  la clave que ese servicio entregó; nunca llega al navegador.
